# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public address of the site, used for login redirects, the sitemap and link previews
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# Your Amazon Associates tag. Every Amazon link gets this added at click time.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=your-tag-21

# Optional: shown on the privacy page. Leave empty to hide the contact section.
NEXT_PUBLIC_CONTACT_EMAIL=

# Shared secret the ETL price poller sends to /api/revalidate (any long random string)
REVALIDATE_SECRET=change-me
