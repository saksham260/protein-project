# Supabase (service role key: server-side only, never ship to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Amazon Creators API (needs Associates account with 10 qualifying sales in last 30 days)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=2.2
AMAZON_PARTNER_TAG=yourtag-21
# Optional overrides - confirm against the Creators API docs for your credential version
AMAZON_CREATORS_TOKEN_URL=
AMAZON_CREATORS_API_URL=

# Website page refresh after each poll
REVALIDATE_URL=https://your-site.example/api/revalidate
REVALIDATE_SECRET=change-me

# Optional: Gemini label reading in `discover` (skip with --no-ai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_IMAGES=6
